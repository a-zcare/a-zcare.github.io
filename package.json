{
  "name": "az-care-web-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "A-Z Care interactive web prototype",
  "scripts": {
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\"",
    "check": "node scripts/check.mjs",
    "test": "npm run format:check && npm run check",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "@playwright/test": "1.55.1"
  }
}
